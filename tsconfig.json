{
    "compilerOptions": {
        "target": "es2020",
        "module": "esnext",
        "lib": ["ES2020"],
        "types": ["node"],
        "declaration": true,
        "strict": true,
        "rootDir": "./src",
        "outDir": "dist",
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": ["src"],
    "exclude": ["node_modules", "dist", "tests", "demo"]
}