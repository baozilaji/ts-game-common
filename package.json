{
  "name": "ts-gs-common",
  "version": "1.0.0",
  "description": "common utils for game server",
  "main": "dist/index.js",
  "type": "module",
  "types": "dist/index.d.ts",
  "scripts": {
    "test": "vitest",
    "build": "tsc",
    "dev": "tsc --watch",
    "format": "prettier --write \"src/**/*.ts\"",
    "demo": "tsx demo/index.ts",
    "prepare": "npm run build",
    "prepublishOnly": "npm run test",
    "preversion": "npm run format",
    "version": "git add -A .",
    "postversion": "git push"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/baozilaji/ts-game-common.git"
  },
  "keywords": [
    "typescript",
    "game server",
    "common utils"
  ],
  "files": [
    "dist/**/*"
  ],
  "author": "baozilaji@126.com",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
